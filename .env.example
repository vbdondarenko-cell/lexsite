# Copy to .env.local. NEVER commit real values.
SITE_URL=http://localhost:3000
# SMTP delivery of consultation requests (recipient must be confirmed by the client)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# Telegram bot delivery of consultation requests (create the bot with @BotFather; never commit real values).
# On the static (FTP) hosting these are set as GitHub repository secrets TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID;
# the deploy workflow writes them to lead-config.php, read by public/lead.php.
TELEGRAM_BOT_TOKEN=
# Telegram user ID(s), comma-separated for several people: 123456789,987654321 (each must press /start in the bot first)
TELEGRAM_CHAT_ID=
